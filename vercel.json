{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/tweet",
      "schedule": "0 8 * * *"
    }
  ],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
